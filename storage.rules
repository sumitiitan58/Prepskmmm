rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.token.email == "Sumit586kumar@gmail.com" ||
        request.auth.token.email == "sumit586kumar@gmail.com" ||
        request.auth.token.email == "sumitiitair01@gmail.com"
      );
    }

    // Cropped Question Images (/questions/{timestamp}_q.png)
    match /questions/{fileName} {
      allow read: if true;
      allow write: if isMasterAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Cropped Step-by-Step Solution Images (/solutions/{timestamp}_s.png)
    match /solutions/{fileName} {
      allow read: if true;
      allow write: if isMasterAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Study Vault PDF Materials (/materials/{filename}.pdf)
    match /materials/{fileName} {
      allow read: if true;
      allow write: if isMasterAdmin()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Custom Material & Video Thumbnails (/thumbnails/{filename}.jpg)
    match /thumbnails/{fileName} {
      allow read: if true;
      allow write: if isMasterAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Student Profile Avatars (/avatars/{uid}/{fileName})
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == uid || isMasterAdmin())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
